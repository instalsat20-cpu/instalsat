generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  image     String?
  role      Role      @default(PARTNER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  fileUrl     String
  fileFormat  String
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Depoimento {
  id         String   @id @default(cuid())
  texto      String
  nome       String
  cargo      String
  fotoUrl    String?
  linkGoogle String?
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  logoUrl     String
  logoDarkUrl String?
  siteUrl     String?
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Solucao {
  id           String   @id @default(cuid())
  categoria    String
  titulo       String
  descricao    String
  imagemUrl    String?
  destaqueHome Boolean  @default(false)
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Projeto {
  id           String   @id @default(cuid())
  categoria    String
  titulo       String
  descricao    String
  imagemUrl    String?
  destaqueHome Boolean  @default(false)
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Processo {
  id        String   @id @default(cuid())
  categoria String
  numero    String
  titulo    String
  descricao String
  imagemUrl String?
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pessoa {
  id          String   @id @default(cuid())
  nome        String
  cargo       String
  descricao   String
  imagemUrl   String?
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Blocos de texto institucional (hero, CTA, história, pilares, footer) que o
// cliente edita com frequência pelo painel. Chave única legível por bloco;
// "grupo" e "label" só orientam a organização da tela de admin.
model BlocoConteudo {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  label     String
  grupo     String
  updatedAt DateTime @updatedAt
}

model Configuracao {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model MarketingIntegrations {
  id              String   @id @default(cuid())
  gtmId           String?
  ga4Id           String?
  googleAdsId     String?
  googleAdsLabel  String?
  metaPixelId     String?
  whatsappNumber  String?
  whatsappMessage String?
  chatProvider    String?
  chatId          String?
  updatedAt       DateTime @updatedAt
}

enum Role {
  STUDIO
  CLIENT_ADMIN
  CLIENT_USER
  PARTNER
}
